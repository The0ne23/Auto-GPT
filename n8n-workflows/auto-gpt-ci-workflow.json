{
  "name": "Auto-GPT CI Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "auto-gpt-ci"
    },
    {
      "parameters": {
        "command": "git clone {{ $json.repository_url }} /tmp/auto-gpt && cd /tmp/auto-gpt && git checkout {{ $json.branch }}"
      },
      "id": "checkout-code",
      "name": "Checkout Repository",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && python -m pip install --upgrade pip && pip install -r requirements.txt"
      },
      "id": "install-deps",
      "name": "Install Dependencies",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && flake8"
      },
      "id": "lint-flake8",
      "name": "Lint with flake8",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && black . --check"
      },
      "id": "check-black",
      "name": "Check Black Formatting",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && isort . --check"
      },
      "id": "check-isort",
      "name": "Check isort Formatting",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && mypy"
      },
      "id": "check-mypy",
      "name": "Check mypy Formatting",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 500]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && pytest -n auto --cov=autogpt --cov-report term-missing --cov-branch --cov-report xml --cov-report term"
      },
      "id": "run-tests",
      "name": "Run Tests with Coverage",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && find tests -type f -name '*.yaml' -print0 | xargs -0 git add"
      },
      "id": "stage-cassettes",
      "name": "Stage Test Cassettes",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "command": "cd /tmp/auto-gpt && git diff --cached --quiet tests || (git config user.name 'Auto-GPT-Bot' && git config user.email 'github-bot@agpt.co' && git commit -m 'Add new cassettes' && git push origin {{ $json.branch }})"
      },
      "id": "commit-push",
      "name": "Commit and Push Changes",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "createComment",
        "owner": "={{ $json.repository_owner }}",
        "repository": "={{ $json.repository_name }}",
        "issueNumber": "={{ $json.pr_number }}",
        "body": "✅ CI Pipeline completed successfully!\n\nLinting: Passed\nTests: Passed\n\nIf cassettes were updated, please run:\n```bash\ngit fetch\ngit rebase origin/{{ $json.branch }}\n```"
      },
      "id": "github-comment",
      "name": "Post GitHub Comment",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1650, 300],
      "credentials": {
        "githubApi": {
          "id": "1",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-success",
      "name": "Check if Successful",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 450]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "createComment",
        "owner": "={{ $json.repository_owner }}",
        "repository": "={{ $json.repository_name }}",
        "issueNumber": "={{ $json.pr_number }}",
        "body": "❌ CI Pipeline failed!\n\nPlease check the logs and fix the issues.\n\nError: {{ $json.error }}"
      },
      "id": "github-comment-fail",
      "name": "Post Failure Comment",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1450, 550],
      "credentials": {
        "githubApi": {
          "id": "1",
          "name": "GitHub account"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Checkout Repository",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Checkout Repository": {
      "main": [
