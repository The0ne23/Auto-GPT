          {
            "node": "Install Dependencies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Install Dependencies": {
      "main": [
        [
          {
            "node": "Lint with flake8",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Black Formatting",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check isort Formatting",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check mypy Formatting",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lint with flake8": {
      "main": [
        [
          {
            "node": "Run Tests with Coverage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Black Formatting": {
      "main": [
        [
          {
            "node": "Run Tests with Coverage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check isort Formatting": {
      "main": [
        [
          {
            "node": "Run Tests with Coverage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check mypy Formatting": {
      "main": [
        [
          {
            "node": "Run Tests with Coverage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Tests with Coverage": {
      "main": [
        [
          {
            "node": "Stage Test Cassettes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stage Test Cassettes": {
      "main": [
        [
          {
            "node": "Commit and Push Changes",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check if Successful",
            "type": "main",
            "index": 0
          }
        ]
      ]
